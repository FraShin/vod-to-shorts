# ==============================================================================
#  VOD -> Shorts pipeline — configuration template
# ==============================================================================
#  Usage:
#      cp .env.example .env        # Windows: copy .env.example .env
#  then fill in only the lines you need. `.env` is gitignored: it stays on your
#  machine and never ends up in the repository.
#
#  Rules:
#    - no quotes around values
#    - no spaces around the =
#    - a variable already present in the system environment takes precedence
#      over this file
#    - every variable is OPTIONAL: the values below are the defaults used when
#      the line is missing
#
#  For "taste" (catch-phrases, triggers, style) see vocabulary.example.json:
#  that does NOT belong here.
# ==============================================================================


# ------------------------------------------------------------------------------
# CREDENTIALS
# ------------------------------------------------------------------------------
# Telegram: notification when the pipeline finishes. Create a bot with @BotFather
# if you don't have one. For the chat ID, message the bot and read the value at
#   https://api.telegram.org/bot<TOKEN>/getUpdates
# If both stay empty the pipeline runs without notifications.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# DeepSeek: used by the agent that picks the clips. Key from
#   https://platform.deepseek.com/api_keys
# Without a key the selection falls back to Spike Recovery + Hype Detector:
# it works, but it picks without judgement.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash


# ------------------------------------------------------------------------------
# PATHS (default: next to the scripts/ folder)
# ------------------------------------------------------------------------------
INPUT_DIR=
OUTPUT_DIR=
CLIPS_DIR=
# Where the clips of the previous run are moved before a new one starts.
# Default: clips_archive/ next to the scripts.
CLIPS_ARCHIVE_DIR=
LOGS_DIR=
# Taste model. Default: vocabulary.json next to the scripts.
VOCABULARY_FILE=


# ------------------------------------------------------------------------------
# VERTICAL LAYOUT (1080x1920)
# ------------------------------------------------------------------------------
# Crop of the webcam and of the game out of the horizontal VOD. These values are
# tuned to one specific OBS layout: if your video is composed differently they
# have to be changed by looking at a frame of the VOD, otherwise the clip comes
# out badly cropped.
SOURCE_X=1
SOURCE_Y=490
SOURCE_W=409
SOURCE_H=348
# Recommended sum: 1920
TARGET_CAM_H=768
TARGET_GAME_H=1152
VIDEO_FPS=60
# Quality: lower = smaller, more compressed file
VIDEO_CQ=22


# ------------------------------------------------------------------------------
# VOD AUDIO TRACKS
# ------------------------------------------------------------------------------
# OBS records several separate tracks. Check which ones you have with:
#   ffprobe -v error -select_streams a -show_entries stream=index,codec_name <vod.mp4>
# 0 = first track.
#
# VOD WITH A SINGLE AUDIO TRACK (already mixed files, e.g. trims or re-exports):
# set all three to 0 and leave MIC_VOLUME=1.0. The mix then becomes a plain
# volume change, instead of summing the same signal twice.
AUDIO_MIC_STREAM_INDEX=1
AUDIO_GAME_STREAM_INDEX=2
# Track used for transcription: must be the clean microphone one
AUDIO_EXTRACT_STREAM_INDEX=1
# Balance in the final mix: voice in front, game audible
MIC_VOLUME=1.2
GAME_VOLUME=0.85


# ------------------------------------------------------------------------------
# TRANSCRIPTION
# ------------------------------------------------------------------------------
# Language spoken in the VOD: it decides what Whisper expects
WHISPER_LANGUAGE=it
# large-v3 = best quality (~3 GB, needs a GPU). For quick tests: small, medium
WHISPER_MODEL=large-v3


# ------------------------------------------------------------------------------
# HOW MANY CLIPS TO PRODUCE
# ------------------------------------------------------------------------------
TARGET_TOTAL_CLIPS=10


# ------------------------------------------------------------------------------
# ENERGY PEAK (internal pipeline signal)
# ------------------------------------------------------------------------------
# Marker the acoustic detector appends to segments containing a scream. It is NOT
# something the streamer says: only change it if you know what you are doing.
ENERGY_SPIKE_MARKER=[ENERGY_SPIKE]
ENERGY_SPIKE_LABEL=ENERGY SPIKE!
# Extra score for a segment with a peak: higher = more clips with shouting
ENERGY_SPIKE_SCORE_BONUS=15.0
# Minimum distance between two peaks treated as distinct (seconds)
COOLDOWN_SECONDS=4.0


# ------------------------------------------------------------------------------
# FFMPEG
# ------------------------------------------------------------------------------
# ffmpeg binary to use. "ffmpeg" is fine if it is on PATH (Linux, WSL, macOS).
# On Windows it often is not: put the full path in quotes, e.g.
# FFMPEG_BIN=C:/ffmpeg/bin/ffmpeg.exe
FFMPEG_BIN=ffmpeg
FFMPEG_TIMEOUT_BASE=600
FFMPEG_TIMEOUT_PER_SEC=12
# 1 = NVIDIA hardware encoding (fast). 0 = libx264 on CPU: much slower, but it
# works on AMD, Intel, Mac and on machines without CUDA drivers.
USE_NVENC=1


# ------------------------------------------------------------------------------
# SUBTITLES
# ------------------------------------------------------------------------------
# Global subtitle delay in seconds. Keep it low (0.08-0.14).
SUB_SYNC_LAG_SEC=0.10
# clip = Whisper re-runs on every rendered clip (better alignment)
# vod  = reuse the full-VOD transcript (faster)
SUB_WORD_SOURCE=clip
SUB_CLIP_WORD_TIMING=whisper
# Maximum words on screen when they are close together
SUB_CHUNK_MAX_WORDS=3
SUB_CHUNK_GAP_SEC=0.35
# tiktok = active word yellow, the others grey | all_yellow = all yellow
SUB_MULTI_WORD_STYLE=tiktok
# Maximum line width: with a 95px font on 1080px do not exceed ~22 characters
SUB_CHUNK_MAX_CHARS=22
# A word longer than this does not share a chunk with other words
SUB_CHUNK_LONG_WORD_CHARS=11


# ------------------------------------------------------------------------------
# STARTUP
# ------------------------------------------------------------------------------
# 1 = do not wipe output/ and clips/ at startup (useful to resume a run)
PIPELINE_NO_WIPE=0