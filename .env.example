# ==============================================================================
#  Pipeline VOD -> Shorts — modello di configurazione
# ==============================================================================
#  Uso:
#      cp .env.example .env        # Windows: copy .env.example .env
#  poi riempi solo le righe che ti servono. `.env` e' gitignorato: resta sul
#  tuo PC e non finisce mai nel repository.
#
#  Regole:
#    - niente virgolette attorno ai valori
#    - niente spazi attorno all'=
#    - una variabile gia' presente nell'ambiente di sistema ha la precedenza
#      su questo file
#    - tutte le variabili sono OPZIONALI: i valori sotto sono i default usati
#      se la riga manca
#
#  Per il "gusto" (catch-phrase, trigger, stile) vedi vocabulary.example.json:
#  quello NON va qui.
# ==============================================================================


# ------------------------------------------------------------------------------
# CREDENZIALI
# ------------------------------------------------------------------------------
# Telegram: notifica a fine pipeline. Crea un bot con @BotFather se non ne hai.
# Per l'ID della chat, scrivi al bot e leggi il valore su
#   https://api.telegram.org/bot<TOKEN>/getUpdates
# Se entrambe restano vuote la pipeline gira senza notifiche.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# DeepSeek: usato dall'agente che sceglie le clip. Chiave da
#   https://platform.deepseek.com/api_keys
# Senza chiave la selezione ripiega su Spike Recovery + Hype Detector:
# funziona, ma sceglie senza intelligenza.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash


# ------------------------------------------------------------------------------
# PERCORSI (default: accanto alla cartella scripts/)
# ------------------------------------------------------------------------------
INPUT_DIR=
OUTPUT_DIR=
CLIPS_DIR=
LOGS_DIR=
# Modello del gusto. Default: vocabulary.json accanto agli script.
VOCABULARY_FILE=


# ------------------------------------------------------------------------------
# LAYOUT VERTICALE (1080x1920)
# ------------------------------------------------------------------------------
# Ritaglio di webcam e gioco dal VOD orizzontale. Questi valori sono tarati su
# un layout OBS specifico: se il tuo video e' composto diversamente vanno
# cambiati guardando un frame del VOD, altrimenti la clip esce tagliata male.
SOURCE_X=1
SOURCE_Y=490
SOURCE_W=409
SOURCE_H=348
# Somma consigliata: 1920
TARGET_CAM_H=768
TARGET_GAME_H=1152
VIDEO_FPS=60
# Qualita': piu' basso = file piu' piccolo e piu' compresso
VIDEO_CQ=22


# ------------------------------------------------------------------------------
# TRACCE AUDIO DEL VOD
# ------------------------------------------------------------------------------
# OBS registra piu' tracce separate. Controlla quali sono con:
#   ffprobe -v error -select_streams a -show_entries stream=index,codec_name <vod.mp4>
# 0 = prima traccia.
AUDIO_MIC_STREAM_INDEX=1
AUDIO_GAME_STREAM_INDEX=2
# Traccia usata per la trascrizione: deve essere quella del microfono pulito
AUDIO_EXTRACT_STREAM_INDEX=1
# Bilanciamento nel mix finale: voce avanti, gioco udibile
MIC_VOLUME=1.2
GAME_VOLUME=0.85


# ------------------------------------------------------------------------------
# TRASCRIZIONE
# ------------------------------------------------------------------------------
# Lingua parlata nel VOD: determina cosa si aspetta Whisper
WHISPER_LANGUAGE=it
# large-v3 = massima qualita' (~3 GB, serve GPU). Per prove rapide: small, medium
WHISPER_MODEL=large-v3


# ------------------------------------------------------------------------------
# QUANTE CLIP PRODURRE
# ------------------------------------------------------------------------------
TARGET_TOTAL_CLIPS=10


# ------------------------------------------------------------------------------
# PICCO ENERGETICO (segnale interno della pipeline)
# ------------------------------------------------------------------------------
# Marker che il rilevatore acustico appende ai segmenti con un urlo. NON e' una
# frase dello streamer: cambialo solo se sai cosa stai facendo.
ENERGY_SPIKE_MARKER=[ENERGY_SPIKE]
ENERGY_SPIKE_LABEL=ENERGY SPIKE!
# Punteggio extra per un segmento col picco: piu' alto = piu' clip con urla
ENERGY_SPIKE_SCORE_BONUS=15.0
# Distanza minima fra due picchi considerati distinti (secondi)
COOLDOWN_SECONDS=4.0


# ------------------------------------------------------------------------------
# FFMPEG
# ------------------------------------------------------------------------------
FFMPEG_TIMEOUT_BASE=600
FFMPEG_TIMEOUT_PER_SEC=12
# 1 = codifica hardware NVIDIA (veloce). 0 = libx264 su CPU: molto piu' lenta,
# ma funziona su AMD, Intel, Mac e su macchine senza driver CUDA.
USE_NVENC=1


# ------------------------------------------------------------------------------
# SOTTOTITOLI
# ------------------------------------------------------------------------------
# Ritardo globale dei sottotitoli in secondi. Tieni basso (0.08-0.14).
SUB_SYNC_LAG_SEC=0.10
# clip = Whisper rigira su ogni clip tagliata (allineamento migliore)
# vod  = usa la trascrizione del VOD intero (piu' veloce)
SUB_WORD_SOURCE=clip
SUB_CLIP_WORD_TIMING=whisper
# Parole massime a schermo quando sono ravvicinate
SUB_CHUNK_MAX_WORDS=3
SUB_CHUNK_GAP_SEC=0.35
# tiktok = parola attiva gialla, le altre grigie | all_yellow = tutte gialle
SUB_MULTI_WORD_STYLE=tiktok
# Larghezza massima della riga: con font 95 su 1080px non superare ~22 caratteri
SUB_CHUNK_MAX_CHARS=22
# Una parola piu' lunga di cosi' non si affianca ad altre nello stesso chunk
SUB_CHUNK_LONG_WORD_CHARS=11


# ------------------------------------------------------------------------------
# AVVIO
# ------------------------------------------------------------------------------
# 1 = non svuotare output/ e clips/ all'avvio (utile per riprendere un run)
PIPELINE_NO_WIPE=0
